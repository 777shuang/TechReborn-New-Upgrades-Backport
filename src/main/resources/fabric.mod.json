{
  "schemaVersion": 1,
  "id": "trnewupgrades",
  "version": "${version}",
  "name": "Tech Reborn New Upgrades",
  "description": "A Tech Reborn addon that adds new upgrades!",
  "authors": [
    "Xurceo"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/tech-reborn-new-upgrades",
    "sources": "https://github.com/Xurceo/TechReborn-New-Upgrades",
    "issues": "https://github.com/Xurceo/TechReborn-New-Upgrades/issues"
  },
  "license": "MIT",
  "icon": "assets/trnewupgrades/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "trnewupgrades.TechRebornNewUpgrades"
    ],
    "client": [
      "trnewupgrades.client.TechRebornNewUpgradesClient"
    ]
  },
  "mixins": [
    "trnewupgrades.mixins.json",
    {
      "config": "trnewupgrades.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.102.0+1.21.1",
    "techreborn": ">=5.11.18",
    "reborncore": ">=5.11.19"
  }
